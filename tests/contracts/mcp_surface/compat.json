            "title": "Frame",
            "type": "string"
          },
          "observer": {
            "default": "SUN",
            "title": "Observer",
            "type": "string"
          },
          "output_file": {
            "default": "",
            "title": "Output File",
            "type": "string"
          },
          "step": {
            "default": "1h",
            "title": "Step",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          },
          "time_end": {
            "default": "",
            "title": "Time End",
            "type": "string"
          }
        },
        "required": [
          "target",
          "time"
        ],
